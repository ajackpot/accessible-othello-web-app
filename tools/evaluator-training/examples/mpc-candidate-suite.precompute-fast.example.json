{
  "name": "mpc-candidate-suite-precompute-fast",
  "outputDir": "tools/evaluator-training/out/mpc-candidate-training-suite-precompute-fast",
  "moduleFormat": "compact",
  "continueOnError": false,
  "sharedProfiles": {
    "evaluationProfileJson": "active",
    "moveOrderingProfileJson": "active",
    "tupleProfileJson": "active",
    "baselineMpcProfileJson": "active"
  },
  "sharedSearchPairs": {
    "mode": "on",
    "checkpointEvery": 50
  },
  "defaults": {
    "sampleStride": 200,
    "sampleResidue": 0,
    "maxSamplesPerBucket": 400,
    "holdoutMod": 10,
    "holdoutResidue": 0,
    "targetHoldoutCoverage": 0.99,
    "timeLimitMs": 120000,
    "progressEvery": 20,
    "maxTableEntries": 200000,
    "aspirationWindow": 40,
    "zValues": [1, 1.5, 1.96, 2.5, 3],
    "exportModule": true,
    "benchmarks": {
      "depth": { "enabled": false },
      "exact": { "enabled": false }
    }
  },
  "candidates": [
    {
      "key": "compact-4bucket-high",
      "name": "compact 4-bucket high-only",
      "calibrationBuckets": ["18-21:4>8", "22-25:4>9", "26-29:5>10", "30-33:6>11"],
      "runtimeVariant": { "defaultMode": "high", "maxChecksPerNode": 1 }
    },
    {
      "key": "zebra-ladder-8bucket-high",
      "name": "zebra ladder 8-bucket high-only",
      "calibrationBuckets": ["18-21:2>8", "18-21:4>8", "22-25:3>9", "22-25:5>9", "26-29:4>10", "26-29:6>10", "30-33:4>11", "30-33:6>11"],
      "runtimeVariant": { "defaultMode": "high", "maxChecksPerNode": 2 }
    },
    {
      "key": "overlap-8bucket-both-softlow",
      "name": "overlap 8-bucket both-mode soft-low",
      "calibrationBuckets": ["18-21:3>7", "18-21:4>8", "22-25:4>8", "22-25:4>9", "26-29:5>10", "26-29:6>10", "30-33:5>11", "30-33:6>10"],
      "runtimeVariant": {
        "defaultMode": "both",
        "maxChecksPerNode": 2,
        "lowScale": 0.9
      }
    }
  ]
}
